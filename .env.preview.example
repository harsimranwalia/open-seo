# Alchemy preview deploys — see docs/PREVIEW_DEPLOYMENTS.md.
# Cloudflare credentials come from `pnpm alchemy login`, not this file.
#
#   cp .env.preview.example .env.preview
#   pnpm deploy:preview --stage <name> --yes

# Required.
# DATAFORSEO_API_KEY=

AUTH_MODE=hosted
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://<stage>.<subdomain>.workers.dev
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# The account's workers.dev subdomain (shown under Workers & Pages).
# WORKERS_SUBDOMAIN=your-subdomain.workers.dev

# Optional.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LOOPS_API_KEY=
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=
